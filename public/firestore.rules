rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }

    function valid() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'type', 'category', 'title', 'body', 'pop', 'assignee', 'due',
          'priority', 'done', 'createdMs', 'createdBy', 'updatedBy',
          'createdAt', 'updatedAt'
        ])
        && (!d.keys().hasAny(['category']) || d.category in ['commands', 'tutorials'])
        && d.type in ['note', 'reminder']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.body is string && d.body.size() <= 10000
        && d.pop is string && d.pop.size() > 0 && d.pop.size() <= 100
        && d.assignee is string && d.assignee.size() <= 100
        && d.due is string && (d.due == '' || d.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.priority in ['Alta', 'Média', 'Baixa']
        && d.done is bool
        && d.createdMs is number
        && d.createdBy is string
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /records/{record} {
      allow read: if member();
      allow create: if member()
        && valid()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if member()
        && valid()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdMs == resource.data.createdMs;
      allow delete: if member();
    }

    // Os documentos de membros são cadastrados pelo administrador no Console Firebase
    // ou por um ambiente administrativo confiável; o site público não pode alterá-los.
    match /members/{uid} {
      allow read, write: if false;
    }
  }
}
